Algoritmo  Promedios
	Definir nota1, nota2, nota3, Promedio Como Real;;
	Escribir "Digite su primera nota";
	Leer nota1;
	Escribir "Ingrese su segunda nota";
	Leer nota2;
	Escribir "Ingrese tu tercera nota";
	Leer nota3;
	Promedio<- (nota1+nota2+nota3)/3;
	Escribir "El promedio de notas es: ",Promedio;
FinAlgoritmo

