Algoritmo  Consumo_Gasolina
	Definir Litros_Gasolina, Kilometros, Resultado Como Real;
	Escribir "Digite los litros de Gasolina Gastados";
	Leer Litros_Gasolina;
	Escribir "Digite los Kilometros recorridos";
	Leer Kilometros;
	Resultado<-Kilometros/Litros_Gasolina;
	Escribir "El consumo de gasolina segun los kilometros es: ",Resultado;
FinAlgoritmo


